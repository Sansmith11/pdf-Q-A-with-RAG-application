# ============================================================
#  PDF Q&A RAG System — Environment Variables
#  Copy this file to `.env` and fill in real values.
# ============================================================

# ----------------------------------------------------------
# Google Gemini API
# Get yours at: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------
GOOGLE_API_KEY=your_gemini_api_key_here

# ----------------------------------------------------------
# Pinecone Vector Database
# Get yours at: https://app.pinecone.io/
# ----------------------------------------------------------
PINECONE_API_KEY=your_pinecone_api_key_here

# ----------------------------------------------------------
# Pinecone Index Configuration
# The index MUST be created with:
#   - Metric: cosine
#   - Dimensions: 768  (matches text-embedding-004 output)
#   - Serverless spec: cloud=aws, region=us-east-1  (or your region)
# ----------------------------------------------------------
PINECONE_INDEX_NAME=pdf-qa-rag

# ----------------------------------------------------------
# Gemini Model Configuration (optional overrides)
# ----------------------------------------------------------
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ----------------------------------------------------------
# RAG Retrieval Defaults (optional overrides)
# ----------------------------------------------------------
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.45
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
